     mat_peptide     1186..1878
                     /gene="gag"
                     /product="Capsid protein CA p24"
                     /note="Forms conical capsid core; N-terminal domain (NTD)
                     and C-terminal domain (CTD); cyclophilin A binding loop;
                     major diagnostic antigen; target of capsid inhibitors
                     (lenacapavir)"
     mat_peptide     1879..2085
                     /gene="gag"
                     /product="Nucleocapsid protein NC p7"
                     /note="Two CCHC zinc finger motifs; RNA chaperone;
                     facilitates tRNA primer annealing and strand transfer
                     during reverse transcription; packages genomic RNA via Psi
                     recognition"
     mat_peptide     2134..2292
                     /gene="gag"
                     /product="p6 protein"
                     /note="PTAP late domain recruits TSG101 (ESCRT-I) for
                     virion budding; LYPxnL motif recruits ALIX; binds Vpr for
                     virion incorporation"
     misc_feature    2083..2093
                     /note="Ribosomal frameshift signal; slippery sequence
                     TTTTTTA followed by RNA stem-loop; ~5% of ribosomes shift
                     -1 to produce Gag-Pol fusion polyprotein; ratio controls
                     PR:RT:IN stoichiometry"
     CDS             2358..5096
                     /gene="pol"
                     /product="Pol polyprotein (Gag-Pol fusion, NH2-terminus
                     uncertain)"
                     /codon_start=1
                     /protein_id="AAB50258.1"
                     /note="Enzymatic polyprotein produced by -1 ribosomal
                     frameshift at gag-pol junction; autocatalytically cleaved
                     by PR into protease, reverse transcriptase/RNase H, and
                     integrase"
     mat_peptide     2358..2617
                     /gene="pol"
                     /product="Protease PR p10"
                     /note="Aspartyl protease; homodimer; cleaves Gag and
                     Gag-Pol at 9 sites; essential for virion maturation; target
                     of protease inhibitors (PIs): darunavir, lopinavir, etc."
     mat_peptide     2618..4229
                     /gene="pol"
                     /product="Reverse transcriptase RT p66/p51"
                     /note="RNA- and DNA-dependent DNA polymerase; p66/p51
                     heterodimer; converts ssRNA genome to dsDNA; contains
                     polymerase domain and RNase H domain (p66 only); target of
                     NRTIs (tenofovir, emtricitabine) and NNRTIs (efavirenz,
                     rilpivirine)"
     mat_peptide     3870..4229
                     /gene="pol"
                     /product="RNase H domain of RT"
                     /note="Degrades RNA strand of RNA:DNA hybrid during
                     minus-strand synthesis; also cleaves RNA primers; part of
                     p66 subunit only"
     mat_peptide     4230..5096
                     /gene="pol"
                     /product="Integrase IN p32"
                     /note="Catalyzes 3' processing and strand transfer of viral
                     dsDNA into host chromosome; three domains: HHCC zinc finger
                     (NTD), catalytic core with DDE motif, C-terminal
                     DNA-binding domain; interacts with LEDGF/p75 for chromatin
                     targeting; target of INSTIs (dolutegravir, bictegravir,
                     cabotegravir)"
     misc_feature    4781..4796
                     /note="Central polypurine tract (cPPT); RNase H-resistant
                     RNA; initiates central plus-strand DNA synthesis; creates
                     central DNA flap; contributes to nuclear import of PIC;
                     used in lentiviral vector design"
     CDS             5041..5619
                     /gene="vif"
                     /product="Viral infectivity factor Vif p23"
                     /codon_start=1
                     /note="Counteracts APOBEC3G and APOBEC3F host restriction
                     factors by recruiting CRL5 E3 ubiquitin ligase
                     (CBFB-RUNX1-Elongin B/C-Cullin5) for their proteasomal
                     degradation; essential for replication in non-permissive
                     cells (T cells, macrophages); absent from virions"
     CDS             5559..5850
                     /gene="vpr"
                     /product="Viral protein R Vpr p15"
                     /codon_start=1
                     /note="Multifunctional accessory protein; packaged in
                     virions via p6 LYPXL motif; facilitates nuclear import of
                     PIC; induces G2/M cell cycle arrest via ATR kinase
                     activation; activates DNA damage response; degrades SLX4
                     complex and HLTF via DCAF1/VprBP"
     CDS             join(5831..6045,8379..8424)
                     /gene="tat"
                     /product="Transactivator protein Tat p14"
                     /codon_start=1
                     /note="Essential transcriptional transactivator; binds TAR
                     RNA hairpin at 5' end of all viral transcripts; recruits
                     P-TEFb (CDK9/CycT1) to hyperphosphorylate RNA Pol II CTD;
                     activates transcription elongation >100-fold; two exons
                     joined by splicing; 86 aa in HXB2 (truncated), 101 aa in
                     most strains"
     exon            5831..6045
                     /gene="tat"
                     /number=1
                     /note="Tat exon 1; encodes N-terminal activation and
                     cysteine-rich domains"
     exon            8379..8424
                     /gene="tat"
                     /number=2
                     /note="Tat exon 2; encodes C-terminal RGD motif; overlaps
                     with rev exon 2"
     CDS             join(5970..6045,8379..8653)
                     /gene="rev"
                     /product="Regulator of expression of virion proteins Rev
                     p19"
                     /codon_start=1
                     /note="Essential post-transcriptional regulator; binds RRE
                     (Rev Response Element) in env via arginine-rich motif
                     (ARM); oligomerizes on RRE; recruits CRM1/exportin-1 via
                     nuclear export signal (NES); exports unspliced (genomic)
                     and singly-spliced mRNAs from nucleus; two exons joined by
                     splicing; overlaps with tat"
     exon            5970..6045
                     /gene="rev"
                     /number=1
                     /note="Rev exon 1; encodes N-terminal domain including ARM
                     (RNA-binding)"
     exon            8379..8653
                     /gene="rev"
                     /number=2
                     /note="Rev exon 2; encodes C-terminal NES (nuclear export
                     signal); overlaps with tat exon 2 and nef"
     CDS             6062..6310
                     /gene="vpu"
                     /product="Viral protein U Vpu p16"
                     /codon_start=1
                     /note="HIV-1-specific accessory protein (absent in
                     HIV-2/SIV); type I integral membrane protein; two
                     functions: (1) targets CD4 for ERAD via beta-TrCP/SCF E3
                     ligase; (2) counteracts BST-2/tetherin restriction factor
                     to enhance virion release; also downregulates NTB-A and
                     PVR"
     CDS             6225..8795
                     /gene="env"
                     /product="Envelope glycoprotein gp160"
                     /codon_start=1
                     /protein_id="AAB50257.1"
                     /note="Envelope polyprotein; cleaved by furin in
                     trans-Golgi to gp120 (SU) + gp41 (TM); forms trimeric
                     spikes on virion surface; mediates receptor binding and
                     membrane fusion; heavily N-glycosylated (~50% mass); target
                     of broadly neutralizing antibodies (bNAbs) and entry
                     inhibitors"
     mat_peptide     6225..7757
                     /gene="env"
                     /product="Surface glycoprotein gp120"
                     /note="Receptor-binding subunit; non-covalently associated
                     with gp41; contains 5 variable loops (V1-V5) and conserved
                     CD4-binding site (CD4bs), co-receptor binding site (V3 loop
                     for CCR5/CXCR4); glycan shield; target of bNAbs (VRC01,
                     3BNC117, 10-1074)"
     mat_peptide     7758..8795
                     /gene="env"
                     /product="Transmembrane glycoprotein gp41"
                     /note="Fusion subunit; N-terminal fusion peptide; heptad
                     repeats HR1 and HR2 form 6-helix bundle during fusion;
                     membrane-proximal external region (MPER); transmembrane
                     anchor; long cytoplasmic tail with Kennedy epitope; target
                     of fusion inhibitors (enfuvirtide/T-20) and bNAbs (10E8,
                     4E10)"
     misc_RNA        7710..8061
                     /gene="RRE"
                     /product="Rev Response Element"
                     /note="~351 nt structured RNA element within env intron;
                     complex stem-loop structure (stems I-V); high-affinity Rev
                     binding site on stem IIB; required for CRM1-mediated
                     nuclear export of unspliced and singly-spliced viral mRNAs;
                     target of RRE-based antivirals"
     CDS             8797..9417
                     /gene="nef"
                     /product="Negative factor Nef p27"
                     /codon_start=1
                     /note="Multifunctional myristoylated accessory protein;
                     downregulates CD4 (via AP-2 clathrin pathway) and MHC-I
                     (via AP-1/PACS-1) from cell surface to evade immune
                     recognition; enhances viral infectivity and replication;
                     activates T cells; critical for AIDS progression
                     (nef-deleted SIV is attenuated); overlaps with 3' LTR"
     misc_feature    9086..9101
                     /note="3' Polypurine tract (3' PPT); purine-rich sequence
                     AAAAGAAAAGGGGG; RNase H-resistant RNA primer; initiates
                     plus-strand strong-stop DNA synthesis; defines U3 boundary"
